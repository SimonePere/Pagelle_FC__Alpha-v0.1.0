# ===========================
# PAGELLE FC- ENVIRONMENT VARIABLES
# ===========================

# ===========================
# DATABASE CONFIGURATION
# ===========================
# MongoDB Atlas Connection
MONGODB_URI_TEST=mongodb+srv://username:password@cluster0.mongodb.net/Pagelle-FC-test?retryWrites=true&w=majority
MONGODB_URI_PROD=mongodb+srv://username:password@cluster0.mongodb.net/Pagelle-FC-prod?retryWrites=true&w=majority

# ===========================
# SERVER CONFIGURATION  
# ===========================
NODE_ENV=development
PORT=5000
APP_ENV=test

# ===========================
# JWT & SECURITY
# ===========================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d
BCRYPT_ROUNDS=12

# ===========================
# CORS & CLIENT
# ===========================
CLIENT_URL_DEV=http://localhost:5173
CLIENT_URL_PROD=https://your-app.vercel.app

# ===========================
# API RATE LIMITING
# ===========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================
# FILE UPLOAD (future)
# ===========================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ===========================
# EMAIL SERVICE (future)
# ===========================
EMAIL_SERVICE=gmail
EMAIL_FROM=noreply@pagellefc.com
EMAIL_USER=
EMAIL_PASS=

# ===========================
# MONITORING & LOGGING
# ===========================
LOG_LEVEL=info
SENTRY_DSN=

# ===========================
# DEPLOYMENT INFO
# ===========================
APP_NAME=Pagelle FC
APP_VERSION=0.1.0
BUILD_DATE=2025-12-15